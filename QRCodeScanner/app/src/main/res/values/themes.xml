<resources>
    <!-- Base application theme. -->
    <style name="Theme.QRCodeScanner" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/beloved_sunflower</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/beloved_sunflower</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/dark_charcoal</item>
        <!-- Customize your theme here. -->
    </style>

    <!--  QR Code Scanner  -->

    <style name="Base">
        <item name="android:background">@color/dark_charcoal_84</item>
        <item name="android:padding">@dimen/_16sdp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="WrapContent">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="WrapContent.FontType">
        <item name="android:fontFamily">@font/itim_regular</item>
    </style>

    <!--  TopBar  -->

    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_16sdp</item>
        <item name="android:layout_marginBottom">@dimen/_36sdp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">@dimen/_4sdp</item>
    </style>

    <style name="WrapContent.FontType.TopBarTitle">
        <item name="android:layout_height">wrap_content</item>
<!--        <item name="android:layout_weight">1</item>-->
        <item name="android:textSize">@dimen/_17ssp</item>
    </style>

    <style name="WrapContent.TopBarButtonBackground">
        <item name="android:background">@drawable/background_bar_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:elevation">@dimen/_10sdp</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/_4sdp</item>
    </style>

    <style name="TopBarButtonImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?selectableItemBackgroundBorderless</item>
    </style>

    <!--  Generate QR  -->

    <style name="GenerateButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:layout_height">@dimen/_76sdp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="GenerateButtonBackground">
        <item name="android:layout_width">@dimen/_66sdp</item>
        <item name="android:layout_height">@dimen/_62sdp</item>
        <item name="android:background">@drawable/btn_background</item>
        <item name="android:layout_alignParentBottom">true</item>
    </style>

    <style name="WrapContent.FontType.GenerateButtonBackgroundTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="WrapContent.FontType.GenerateButtonBackgroundTitle.Title">
        <item name="android:fontFamily">@font/itim_regular</item>
        <item name="android:background">@drawable/text_background</item>
        <item name="android:padding">@dimen/_4sdp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>

    <style name="GenerateButtonImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_16sdp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <!--  SettingActivity  -->

    <style name="WrapContent.FontType.title">
        <item name="android:layout_marginBottom">@dimen/_20sdp</item>
        <item name="android:textColor">@color/beloved_sunflower</item>
        <item name="android:textSize">@dimen/_20ssp</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/background_card_setting</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">@dimen/_10sdp</item>
    </style>

    <style name="WrapContent.SettingsCardIcon">
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">@dimen/_2sdp</item>
    </style>

    <style name="WrapContent.SettingsCardInnerContainer">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:selectableItemBackgroundBorderless</item>
        <item name="android:layout_marginStart">@dimen/_10sdp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WrapContent.FontType.SettingsCardTitle">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="WrapContent.FontType.SettingsCardSubTitle">
        <item name="android:textColor">@color/gray</item>
    </style>

    <!--  HistoryActivity  -->
    <style name="CustomTabTextAppearance" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <!--  Title TextField for Generate -->

    <style name="Image">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_40sdp</item>
    </style>

    <style name="TitleTextField">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_16sdp</item>
        <item name="android:fontFamily">@font/itim_regular</item>
        <item name="android:textSize">@dimen/_15ssp</item>
    </style>

    <style name="EditText">
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/_8sdp</item>
        <item name="android:layout_marginTop">@dimen/_4sdp</item>
        <item name="android:background">@drawable/background_edit_text</item>
        <item name="android:fontFamily">@font/itim_regular</item>
        <item name="android:padding">@dimen/_8sdp</item>
        <item name="android:textColorHint">@color/gray</item>
    </style>

    <style name="Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_32sdp</item>
        <item name="android:background">@drawable/background_button</item>
        <item name="android:paddingVertical">@dimen/_8sdp</item>
        <item name="android:text">Generate QR Code</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
    </style>

</resources>