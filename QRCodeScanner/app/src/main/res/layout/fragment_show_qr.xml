<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Base"
    android:padding="0dp"
    tools:context=".ShowQRFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/background_image" />

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/Base"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout2"
            style="@style/TopBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/btn_back"
                style="@style/WrapContent.TopBarButtonBackground">

                <ImageView
                    style="@style/TopBarButtonImage"
                    android:paddingLeft="@dimen/_4sdp"
                    app:srcCompat="@drawable/ic_back" />
            </LinearLayout>

            <TextView
                style="@style/WrapContent.FontType.TopBarTitle"
                android:layout_marginLeft="@dimen/_10sdp"
                android:text="@string/qr_code" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_36sdp"
            app:cardBackgroundColor="@color/dark_charcoal"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_16sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linearLayout2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_10sdp">

                <TextView
                    android:id="@+id/type"
                    style="@style/WrapContent.FontType.SettingsCardTitle"
                    android:text="Data"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintStart_toEndOf="@+id/parent"
                    app:layout_constraintTop_toTopOf="@+id/parent" />

                <TextView
                    android:id="@+id/data"
                    style="@style/WrapContent.FontType.SettingsCardSubTitle"
                    android:text="https://www.youtube.com/watch?v=Zd9g7sKvgIM"
                    app:layout_constraintStart_toStartOf="@+id/parent"
                    app:layout_constraintTop_toBottomOf="@+id/type" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_180sdp"
            android:layout_marginTop="@dimen/_16sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/materialCardView"
            app:srcCompat="@drawable/ic_qr" />

        <LinearLayout
            android:id="@+id/btn_share"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:background="@drawable/background_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            app:layout_constraintEnd_toStartOf="@id/btn_save"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qr_image">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_share_black" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_save"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_64sdp"
            android:background="@drawable/background_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_share"
            app:layout_constraintTop_toBottomOf="@+id/qr_image">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_save" />
        </LinearLayout>

        <TextView
            android:id="@+id/textView"
            style="@style/WrapContent.FontType.SettingsCardTitle"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/share"
            app:layout_constraintEnd_toEndOf="@id/btn_share"
            app:layout_constraintStart_toStartOf="@id/btn_share"
            app:layout_constraintTop_toBottomOf="@+id/btn_share" />

        <TextView
            style="@style/WrapContent.FontType.SettingsCardTitle"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/save"
            app:layout_constraintEnd_toEndOf="@+id/btn_save"
            app:layout_constraintStart_toStartOf="@+id/btn_save"
            app:layout_constraintTop_toBottomOf="@+id/btn_save" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>